PROJECT_NAME="LMS Backend API"
API_V1_STR="/api/v1"
SECRET_KEY="change-this-in-production-super-secret-key-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Default SQLite for easy local development
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/lms_db
